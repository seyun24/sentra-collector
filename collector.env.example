# Save the settings issued by Sentra as collector.env (never commit the real file).
SENTRA_INGEST_BASE_URL=https://ingest.example.com
SENTRA_WORKSPACE_ID=REPLACE_WORKSPACE_ID
SENTRA_COLLECTOR_ID=REPLACE_COLLECTOR_ID
SENTRA_COLLECTOR_TOKEN=REPLACE_COLLECTOR_TOKEN
SENTRA_HOST_ID=REPLACE_HOST_ID
SENTRA_HOSTNAME=REPLACE_HOSTNAME
SENTRA_SERVICE_NAME=system
SENTRA_ENVIRONMENT=production
SENTRA_COLLECTOR_INTERVAL_SECONDS=10
# Host process/network visibility. false keeps container PID/network isolation.
SENTRA_INSTALL_HOST_METRICS=true
# Optional log input: absolute path[:service[:type]], comma separated.
SENTRA_COLLECTOR_LOG_SOURCES=
# The installer automatically mounts each configured parent directory read-only.
SENTRA_COLLECTOR_TRACE_JSONL_PATH=
SENTRA_COLLECTOR_DB_TYPE=
SENTRA_COLLECTOR_DB_SQLITE_PATH=
# Optional MySQL probe (native Linux host networking supports localhost).
SENTRA_COLLECTOR_DB_MYSQL_HOST=
SENTRA_COLLECTOR_DB_MYSQL_PORT=3306
SENTRA_COLLECTOR_DB_MYSQL_USER=
SENTRA_COLLECTOR_DB_MYSQL_PASSWORD=
SENTRA_COLLECTOR_DB_MYSQL_DATABASE=
